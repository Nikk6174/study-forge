# Server-side only. Never prefix with VITE_ (that would bundle it into the browser).
GEMINI_API_KEY=your-key-here
# Optional: comma-separated model chain. First is primary, the rest are fallbacks.
GEMINI_MODELS=gemini-flash-lite-latest,gemini-2.5-flash
# Optional: allow the ?debug failure simulator outside local dev.
ALLOW_SIMULATE=false
